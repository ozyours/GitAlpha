{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "atlasui": {
      "path": "../AtlasUI",
      "description": "AtlasUI - the Java UI framework consumed by GitAlpha. Use when working with framework components, layout containers, theming/skins, or CSS conventions that GitAlpha depends on."
    }
  },
  "instructions": ["../AtlasUI/AGENTS.md"],
  "permissions": [
    {
      "action": "external_directory",
      "resource": "../AtlasUI/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "../AtlasUI/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "../AtlasUI/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "mvn *",
      "effect": "allow"
    }
  ]
}

